NODE_ENV=dev
PORT=3000
LOG_LEVEL=info

DB_TYPE=postgres
DB_HOST=localhost
DB_PORT=5432
DB_NAME=kulina
DB_USER=postgres
DB_PASSWORD=postgres
DB_SYNC=true
DB_SSL=false

JWT_SECRET=replace-with-a-long-random-secret
JWT_REFRESH_SECRET=replace-with-another-long-random-secret
JWT_ACCESS_EXPIRATION_TIME=7d
JWT_REFRESH_EXPIRATION_TIME=30d
RESET_PASSWORD_EXPIRATION_TIME=30m

SUPER_ADMIN=super_admin
ADMIN_ROLE=admin
MODERATOR_ROLE=moderator
CONTRIBUTOR_ROLE=contributor
USER_ROLE=user

MAIL_HOST=
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM=no-reply@kulina.app

FRONTEND_URL=http://localhost:3001
RESET_PASSWORD_LINK=http://localhost:3001/reset-password?token=

ENABLE_SWAGGER=true
SWAGGER_USERNAME=kulina
SWAGGER_PASSWORD=kulina

# Cloudinary
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Redis
REDIS_URL=redis://localhost:6379

# Gemini AI
GEMINI_API_KEY=
GEMINI_CHAT_MODEL=gemini-flash-latest
GEMINI_VISION_MODEL=gemini-flash-latest
GEMINI_TTS_MODEL=gemini-flash-latest
AI_CHAT_DAILY_QUOTA=40
AI_PHOTO_DAILY_QUOTA=3
GEMINI_INPUT_COST_PER_1K_USD=0.0001
GEMINI_OUTPUT_COST_PER_1K_USD=0.0004

# Free mode toggle (set true to make AI chat and photo checks free for all users)
ALL_FEATURES_FREE=true

# Premium / Mobile Money
PREMIUM_PRICE_XOF=2500
MOBILE_MONEY_PROVIDER=manual
MOBILE_MONEY_BASE_URL=
MOBILE_MONEY_API_KEY=
MOBILE_MONEY_API_SECRET=
MOBILE_MONEY_WEBHOOK_SECRET=
MOBILE_MONEY_CHECKOUT_PATH=/checkout
MOBILE_MONEY_CALLBACK_URL=http://localhost:3000/api/v1/webhooks/payments
