NODE_ENV=dev
PORT=3000
LOG_LEVEL=info

DB_TYPE=postgres
DB_HOST=localhost
DB_PORT=5432
DB_NAME=kulina
DB_USER=postgres
DB_PASSWORD=postgres
DB_SYNC=true
DB_SSL=false

JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRATION_TIME=7d
RESET_PASSWORD_EXPIRATION_TIME=30m

SUPER_ADMIN=super_admin
ADMIN_ROLE=admin
MODERATOR_ROLE=moderator
CONTRIBUTOR_ROLE=contributor
USER_ROLE=user

MAIL_HOST=
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM=no-reply@kulina.app

FRONTEND_URL=http://localhost:3001
RESET_PASSWORD_LINK=http://localhost:3001/reset-password?token=

ENABLE_SWAGGER=true
SWAGGER_USERNAME=kulina
SWAGGER_PASSWORD=kulina

# Cloudinary
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
